; Ejemplo de zona Flesk (generada en runtime — no usar como plantilla render)
$TTL 3600
@	IN	SOA	ns1.ejemplo.com. admin.ejemplo.com. (
			2026010101	; serial
			3600		; refresh
			900		; retry
			604800		; expire
			3600		; minimum
			)
@	3600	IN	NS	ns1.ejemplo.com.
ns1	3600	IN	A	203.0.113.10
@	3600	IN	A	203.0.113.10
@	3600	IN	MX	10 ejemplo.com.
@	3600	IN	TXT	""
