# Flesk Mini — variables opcionales para install.sh / optional install.sh variables
# Copia: cp .env.example .env && set -a && . ./.env && set +a && sudo -E ./install.sh
# La configuración real la genera install.sh en /opt/flesk/config.conf (ver config.example.conf).

# Dominio del panel (vacío = https://<IP>/flesk con certificado autofirmado)
PANEL_DOMAIN=
# Email del administrador / Let's Encrypt
ADMIN_EMAIL=admin@example.com
# IP pública (vacío = autodetectar)
PUBLIC_IP=
